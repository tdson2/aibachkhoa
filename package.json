{
  "name": "aibachkhoa-landing",
  "version": "1.0.0",
  "description": "Premium landing page for AIBachKhoa",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run blog && npm run og && npm run social && npm run schema && npm run i18n && npm run track && npm run sitemap",
    "og": "python3 tools/build-og-images.py",
    "social": "python3 tools/build-social-tags.py",
    "schema": "node tools/build-structured-data.js",
    "blog": "node tools/build-blog.js",
    "i18n": "node tools/build-i18n-pages.js",
    "i18n:check": "node tools/check-i18n.js",
    "track": "node tools/build-analytics-tag.js",
    "sitemap": "node tools/build-sitemap.js",
    "webp": "python3 tools/build-webp.py",
    "seed": "node tools/seed-analytics.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
